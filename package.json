{
  "name": "bookingandmatchmaking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "test:race": "vitest run supabase/tests/race",
    "db:lint": "supabase db advisors --local --type all --fail-on warn",
    "test:integration": "pnpm --filter web test:integration",
    "env:local": "pnpm --filter web env:local",
    "env:hosted": "pnpm --filter web env:hosted",
    "admin:grant": "node apps/web/scripts/grant-platform-admin.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
