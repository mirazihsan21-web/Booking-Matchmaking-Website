# Copy to .env.local, or generate it from the local stack with: pnpm env:local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from `pnpm exec supabase status`>
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<SECRET_KEY from `pnpm exec supabase status`>
# Root host; tenants live on <slug>.<root>. Locally: localhost:3000 → http://<slug>.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Shows the "Continue with Google" button. Needs GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET for Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Shared secret for POST /api/jobs/tick (called every 10 s by pg_cron through pg_net). The database
# holds the same value in Vault as `job_secret`, next to `app_url`. pnpm env:local sets both.
JOB_SECRET=<random 64 hex characters>
# Notification email: `smtp` (Mailpit locally, or a real server such as Gmail) or `resend` (needs a
# verified domain). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the Gmail address>,
# SMTP_PASS=<a Google App Password>, and EMAIL_FROM must use that Gmail address (about 500 emails a day).
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Booking & Matchmaking <bookings@localhost>
# Only for EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
